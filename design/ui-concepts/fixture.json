    {
      "id": "bridge",
      "number": "二",
      "title": "桥头阻击",
      "subtitle": "最后走的人",
      "setting": "淞沪战场 · 虚构支线",
      "duration": "短篇 · 约8—12次行动",
      "description": "身后的人正在过桥。火力、掩体与轮换都得算，而任务完成后，你还需要把掩护小队撤出来。",
      "objective": "掩护60名友军过桥，再于180分钟封锁前确认撤出小队。",
      "opening": "桥头，临时掩护阵地。\n\n传令兵指向桥面：“还有六十个人。那边有人接，咱们看住这一头。”你问他最后一队怎么走，他没立刻答，先看了看身边的人。\n\n每2分钟可让1名友军过桥，交谈不推进时间。压制射击、加固与轮换各有代价；60人过桥后，明确下令撤离并再次确认。180分钟后通路关闭，不能一直守到没有退路。\n\n本章为虚构支线，与四行仓库切换小队视角。",
      "next": "sihang",
      "tactics": [
        {
          "id": "rapid_crossing",
          "chapterId": "bridge",
          "title": "加速渡桥",
          "description": "传令兵拿着分批接应的草案：“到了那边，谁负责再点一次名？您得给我一句准话。”",
          "effect": "一次20分钟压制掩护，过桥人数上限10→20人。",
          "tradeoff": "本次七九弹共60发、压力最多+16，额外疲劳最多+8；至少11人尚未过桥。"
        },
        {
          "id": "covered_withdrawal",
          "chapterId": "bridge",
          "title": "交替撤离",
          "description": "“谁都不单留下。”班长指着两组的名单，“最后走的人，也得有人接。”",
          "effect": "本次撤离若接敌，小队伤亡最多减少2人。",
          "tradeoff": "撤离20→30分钟；仍须二次确认、达成目标并赶在封锁前撤出。"
        }
      ],
