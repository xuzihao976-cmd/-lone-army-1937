  "chapters": [
    {
      "id": "street",
      "number": "一",
      "title": "街巷撤收",
      "subtitle": "把人带回来",
      "setting": "淞沪战场 · 虚构支线",
      "duration": "短篇 · 约10—15次行动",
      "description": "巷道里还有人没有出来。先查清路，再在封锁前接回他们；不是找到人就算救到了人。",
      "objective": "180分钟内护送至少8名被困民众到安全区，并确认撤出小队。",
      "opening": "傍晚，临时接应所。\n\n门板上压着一份十二人的求援登记，有人把同一家人的名字写在了一起。老班长把纸折好：“找到了，也得带出来。别隔着一条街就说人已经安全。”\n\n先侦察路线，再选择内巷或沿河撤收线；搜救找到的人需要另行护送。封锁会在180分钟后收紧，至少护送8人并让小队撤离才算完成。\n\n本章人物与行动为虚构支线，不对应某次真实史实。",
      "next": "bridge",
      "tactics": [
        {
          "id": "group_escort",
          "chapterId": "street",
          "title": "分组接应",
          "description": "班长压着名单：“前后都得有人照看。多带两个，不是把队伍往一块挤。”",
          "effect": "一次护送上限6→8人，仍按已选路线耗时。",
          "tradeoff": "额外消耗20发七九弹，基础压力增量额外+8；至少7人等待护送。"
        },
        {
          "id": "wall_hug",
          "chapterId": "street",
          "title": "贴墙慢行",
          "description": "“慢一点，让后头的人跟上。”班长指着路边的遮蔽；这条路不会变短，要走得稳，就得多留些时间。",
          "effect": "一次护送的压力增量降低15点。",
          "tradeoff": "护送额外耗时10分钟，封锁期限照常推进。"
        }
      ],
